---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="bm-header">
  <DefaultHeader />
  <nav class="bm-top-nav" aria-label="주요 문서 섹션">
    <a href={`${base}/`} aria-current={Astro.url.pathname === `${base}/` ? 'page' : undefined}>시작</a>
    <a href={`${base}/design/`} aria-current={Astro.url.pathname === `${base}/design/` ? 'page' : undefined}>설계</a>
    <a href={`${base}/evaluation/`} aria-current={Astro.url.pathname === `${base}/evaluation/` ? 'page' : undefined}>평가</a>
    <a href={`${base}/notes/`} aria-current={Astro.url.pathname === `${base}/notes/` ? 'page' : undefined}>기록</a>
  </nav>
</div>
