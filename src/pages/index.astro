---
import App from '../components/App.jsx';
import * as overview from '../content/docs/index.md';
import * as memorySave from '../content/docs/memory/what-gets-saved.md';
import * as memoryRetrieval from '../content/docs/memory/how-memories-are-retrieved.md';
import * as architecture from '../content/docs/architecture/Architecture.md';
import 'katex/dist/katex.min.css';

const technicalSeries = import.meta.glob('../content/docs/technical-series/**/*.md', { eager: true });
const documents = Object.fromEntries(await Promise.all(
	[
		['overview', overview],
		['architecture', architecture],
		['memory-save', memorySave],
		['memory-retrieval', memoryRetrieval],
		...Object.entries(technicalSeries).map(([path, source]) => [path.split('/').slice(-2).join('-').replace(/\.md$/, '').toLowerCase(), source]),
	].map(async ([id, source]) => [id, {
		title: source.frontmatter.title,
		description: source.frontmatter.description,
		html: await source.compiledContent(),
		headings: (await source.getHeadings()).filter((heading) => heading.depth === 2),
	}])
));
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={documents.overview.description} />
		<meta name="theme-color" content="#0d1118" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}/favicon-32.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${import.meta.env.BASE_URL}/site.webmanifest`} />
		<title>별무리 AI 문서</title>
	</head>
	<body>
		<App client:load documents={documents} />
	</body>
</html>
