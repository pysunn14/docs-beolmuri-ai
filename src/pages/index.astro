---
import App from '../components/App.jsx';
import * as overview from '../content/docs/index.md';

const overviewHtml = await overview.compiledContent();
const overviewHeadings = (await overview.getHeadings()).filter((heading) => heading.depth === 2);
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={overview.frontmatter.description} />
		<title>별무리 AI 문서</title>
	</head>
	<body>
		<App
			client:load
			overviewTitle={overview.frontmatter.title}
			overviewDescription={overview.frontmatter.description}
			overviewHtml={overviewHtml}
			overviewHeadings={overviewHeadings}
		/>
	</body>
</html>
